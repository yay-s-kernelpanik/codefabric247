# Fabrica247 local supervisor configuration
TARGET_REPO=
HYPERROUTER_URL=http://127.0.0.1:8787/v1
# HYPERROUTER_API_KEY=your-local-key
FABRICA_MODEL=hyperrouter/auto
OPENCODE_BIN=opencode
TASK_TIMEOUT=900
TEST_TIMEOUT=600
POLL_INTERVAL=10
INFRA_BACKOFF=120

# The local supervisor needs shell/edit tools for autonomous coding and tests.
# Keep enabled only for tasks and repositories you trust.
ALLOW_ALL_PERMISSIONS=true
REQUIRE_ROUTER=true
